{
  "name": "backend",
  "private": true,
  "scripts": {
    "dev": "tsx watch ./src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db": "NODE_OPTIONS=\"--no-network-family-autoselection --dns-result-order=ipv4first\" drizzle-kit push --config=src/drizzle.config.ts",
    "db:push": "NODE_OPTIONS=\"--no-network-family-autoselection --dns-result-order=ipv4first\" drizzle-kit push --config=src/drizzle.config.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.2.8",
    "@clerk/express": "^2.1.0",
    "@imagekit/nodejs": "^7.4.0",
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/node": "^10.48.0",
    "@sentry/profiling-node": "^10.48.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "express": "^5.2.1",
    "pg": "^8.13.1",
    "standardwebhooks": "^1.0.0",
    "stream-chat": "^8.57.6",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.10",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
